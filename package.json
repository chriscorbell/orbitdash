{
  "name": "orbitdash",
  "private": true,
  "version": "0.4.0",
  "packageManager": "bun@1.4.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "bun --watch server/index.ts",
    "dev:all": "bun run dev & bun run dev:server",
    "dev:all:host": "vite --host & bun run dev:server",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build && node scripts/compress-assets.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "prepare": "node scripts/prepare-git-hooks.mjs",
    "start": "NODE_ENV=production bun server/index.ts",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:unit": "vitest --run shared src",
    "test:integration": "bun test server",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:watch": "vitest --watch",
    "test:coverage": "npm run test:coverage:shared && npm run test:coverage:frontend && npm run test:coverage:server",
    "test:coverage:shared": "vitest --run shared --coverage --coverage.reporter=text",
    "test:coverage:frontend": "vitest --run src --coverage --coverage.reporter=text --coverage.include='src/{App.tsx,components/{ServiceCard,ServiceDialog,ServicesSection,header/AppHeader,settings/SettingsDialog,services/CategorySectionList,services/ServiceStatusCheckField,status/ServiceStatus}.tsx,components/status/{useServiceStatus,status-format}.ts,hooks/{useCategoryOrder,useDashboardSettings,useMetrics,useServices}.ts,lib/{api/client,live/metrics-store,board-layout,icon-tone,pwa}.ts,sw/{precache,respond,routes,strategies}.ts}' --coverage.thresholds.statements=75 --coverage.thresholds.branches=55 --coverage.thresholds.functions=70 --coverage.thresholds.lines=75",
    "test:coverage:server": "bun test server --coverage && node scripts/check-lcov-coverage.mjs coverage/server/lcov.info 75 80"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.8",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "uplot": "^1.6.32",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.10.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.7",
    "simple-git-hooks": "^2.14.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "pre-push": "npm run typecheck && npm run test:unit"
  },
  "lint-staged": {
    "*.{css,html,json,md,ts,tsx,yml,yaml}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --max-warnings=0"
    ]
  },
  "overrides": {
    "@babel/core": "^7.29.1",
    "brace-expansion": "^5.0.6",
    "esbuild": "^0.28.1",
    "flatted": "^3.4.2",
    "minimatch": "^10.2.5",
    "picomatch": "^4.0.4"
  }
}
